# Public root contents are explicit; unrelated local files stay out of Git.
/*
!/.gitignore
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/week2/

# Configuration and credentials; placeholder templates are public.
.env
.env.*
*.env
!.env.example
secrets/
secrets.*
credentials/
credentials.*
*credentials*.json
service-account*.json
*service_account*.json
*.pem
*.key
*.p12
*.pfx
*.jks
db_password
.netrc
.npmrc
.pypirc

# Users, sessions, database state and downloaded models.
private/
data/private/
*.dump
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.db
*.backup
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm
*.safetensors
*.pt
*.pth
*.onnx

# Environments, dependencies, build products and test artifacts.
.venv/
venv/
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit*.xml
.ipynb_checkpoints/
node_modules/
build/
dist/
*.egg-info/

# Working reports, intermediate documentation and preservation copies.
reports/
full_report*
stage*_report*
stage*_plan*
audit*.md
plan*.md
notes*.md
.publication-backup/
*.tmp
*.bak
*.orig
*.building*

# Only curated assignment evidence is allowed by the nested rules.
*.log
*.log.*
*.jsonl
*.jsonl.*
week02_agents.ipynb
week2_agents.ipynb
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
